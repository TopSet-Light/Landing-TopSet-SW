# Las variables con prefijo VITE_ son públicas: nunca colocar secretos aquí.

# Clave de Web3Forms (https://web3forms.com) para que el formulario de contacto envíe
# directo a la casilla registrada. Es pública por diseño. Copiá este archivo como .env
# y completala. Si queda vacía, el formulario abre el programa de correo (mailto).
# En el hosting también se acepta sin prefijo: WEB3FORMS_ACCESS_KEY o ACCESS_KEY.
VITE_WEB3FORMS_ACCESS_KEY=
